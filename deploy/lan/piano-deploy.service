[Unit]
Description=Build and publish the piano app from GitHub main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=piano
Group=piano
Environment=PATH=/home/piano/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/piano-deploy
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/piano /home/piano
